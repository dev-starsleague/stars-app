# URL del backend FastAPI condiviso con stars-system (stesso backend, stesso
# database — nessun backend separato per l'app).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Su un device fisico o un simulatore, 127.0.0.1 punta al device stesso, non
# al Mac che esegue il backend: sostituiscilo con l'IP LAN del Mac, es.
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
